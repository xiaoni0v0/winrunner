{
  "name": "@local/dsh-winrunner-client",
  "version": "1.3.1",
  "description": "DeepSeek Harness client tools for WinRunner",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dsh-winrunner/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./dsh-winrunner/locale/*.json",
    "./icon": "./dsh-winrunner/icon.svg"
  },
  "files": [
    "dsh-winrunner/index.js",
    "dsh-winrunner/client.js",
    "dsh-winrunner/cordis.patch.yml",
    "dsh-winrunner/locale/*.json",
    "dsh-winrunner/icon.svg",
    "dsh-winrunner/client.example.json",
    "dsh-winrunner/README.md"
  ],
  "scripts": { "test": "node --test dsh-winrunner/test/*.test.js" },
  "dsh": { "bundle": { "patch": "./dsh-winrunner/cordis.patch.yml" } }
}
